# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# ---- WhatsApp (CallMeBot - gratuito) ----
# Siga o guia em: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 1. Salve o contato +34 644 59 21 95 no celular como "CallMeBot"
# 2. Envie "I allow callmebot to send me messages" para esse contato via WhatsApp
# 3. Você receberá sua API key

WHATSAPP_PROVIDER=callmebot
CALLMEBOT_PHONE=5531999990001        # DDD + número, sem + nem espaços
CALLMEBOT_API_KEY=123456             # Chave recebida do bot

# ---- WhatsApp (Twilio - produção) ----
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=whatsapp:+14155238886   # Número Twilio Sandbox
# TWILIO_TO=whatsapp:+5531999990001

# ---- Notificações ----
NOTIFICAR_LIBERADO=false   # true para notificar também quando liberar
NOTIFICAR_NEGADO=true      # true para notificar apenas acessos negados
